+}
+
+@media (max-width: 640px) {
+  .receipt-cover-frame { width: 96px; margin-bottom: 14px; }
+}
+
+/* ═════════════════════════════════════════════════════════════════
+   POLISH BLOCK 3 — Landing hero, onboarding, mobile polish
+   ═════════════════════════════════════════════════════════════════ */
+
+/* ── Hero: entrance animation + gold accent ── */
+@keyframes bv-hero-rise {
+  from { opacity: 0; transform: translateY(10px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+@keyframes bv-hero-fade {
+  from { opacity: 0; }
+  to   { opacity: 1; }
+}
+@keyframes bv-hero-shimmer {
+  0%, 100% { background-position: 0% 50%; }
+  50%      { background-position: 100% 50%; }
+}
+
+.journey-bar-copy .eyebrow {
+  animation: bv-hero-fade 0.6s ease-out 0.05s both;
+}
+.journey-bar-copy h1 {
+  animation: bv-hero-rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both;
+  background: linear-gradient(
+    90deg,
+    var(--book-ink) 0%,
+    #f5e9d2 50%,
+    var(--book-ink) 100%
+  );
+  background-size: 200% 100%;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  animation: bv-hero-rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both,
+             bv-hero-shimmer 6s ease-in-out 1s infinite;
+}
+.journey-bar-copy p {
+  animation: bv-hero-rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.28s both;
+}
+.journey-bar-track {
+  animation: bv-hero-fade 0.7s ease-out 0.4s both;
+}
+
+/* Subtle ornament divider under the hero copy */
+.journey-bar-copy::after {
+  content: '\2756';
+  display: block;
+  color: rgba(201, 169, 97, 0.55);
+  font-size: 12px;
+  letter-spacing: 0.5em;
+  margin-top: 2px;
+  animation: bv-hero-fade 0.8s ease-out 0.5s both;
+}
+
+/* ── Onboarding toast (first login / register) ── */
+.bv-onboarding-toast {
+  position: fixed;
+  left: 50%;
+  top: 96px;
+  transform: translateX(-50%);
+  z-index: 120;
+  padding: 14px 22px;
+  border-radius: 999px;
+  background: linear-gradient(135deg, rgba(30, 24, 22, 0.96), rgba(18, 15, 18, 0.96));
+  border: 1px solid rgba(201, 169, 97, 0.35);
+  box-shadow: 0 20px 48px -18px rgba(0, 0, 0, 0.8), 0 0 40px -10px rgba(201, 169, 97, 0.4);
+  color: var(--book-ink, #ebe1d2);
+  font-size: 13px;
+  letter-spacing: 0.02em;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  max-width: calc(100vw - 32px);
+  animation: bv-onboarding-enter 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both,
+             bv-onboarding-leave 0.5s ease-in forwards 4.5s;
+  pointer-events: none;
+}
+.bv-onboarding-toast::before {
+  content: '\2756';
+  color: var(--bv-gold, #c9a961);
+  font-size: 14px;
+}
+@keyframes bv-onboarding-enter {
+  from { opacity: 0; transform: translate(-50%, -12px); }
+  to   { opacity: 1; transform: translate(-50%, 0); }
+}
+@keyframes bv-onboarding-leave {
+  to { opacity: 0; transform: translate(-50%, -12px); }
+}
+
+/* ── Mobile polish ── */
+@media (max-width: 640px) {
+  .compact-topbar {
+    padding: calc(12px + env(safe-area-inset-top, 0px)) 14px 10px;
+    gap: 8px;
+  }
+  .brand-copy strong { font-size: 0.95rem; }
+  .reader-journey-bar { padding: 14px 16px 12px; }
+  .journey-bar-copy h1 {
+    font-size: clamp(1.55rem, 7vw, 2rem);
+    max-width: 18ch;
+  }
+  .journey-bar-copy p { font-size: 0.9rem; }
+  .reader-stage-panel {
+    grid-template-columns: 1fr;
+    padding: 14px 16px;
+    gap: 14px;
