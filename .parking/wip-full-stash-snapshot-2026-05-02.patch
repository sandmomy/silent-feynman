+}
+
+/* ═════════════════════════════════════════════════════════════════
+   POLISH BLOCK 1 — Typography scale, micro-interactions, skeletons
+   ═════════════════════════════════════════════════════════════════ */
+
+/* ── Typography scale (consistent across pages) ── */
+.customer-app h1 {
+  font-size: clamp(1.9rem, 3.4vw, 2.8rem);
+  line-height: 1.08;
+  letter-spacing: -0.01em;
+}
+.customer-app h2 {
+  font-size: clamp(1.35rem, 2.4vw, 1.85rem);
+  line-height: 1.14;
+  letter-spacing: -0.005em;
+}
+.customer-app h3 {
+  font-size: clamp(1.05rem, 1.6vw, 1.3rem);
+  line-height: 1.2;
+}
+.customer-app p {
+  line-height: 1.55;
+}
+.customer-app .eyebrow,
+.customer-app .catalog-hero-eyebrow {
+  font-size: 11px;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+}
+
+/* ── Card entrance animation (stagger) ── */
+@keyframes bv-card-rise {
+  from { opacity: 0; transform: translateY(14px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+.sacred-library-grid > .sacred-book-card {
+  animation: bv-card-rise 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+.sacred-library-grid > .sacred-book-card:nth-child(1) { animation-delay: 0.02s; }
+.sacred-library-grid > .sacred-book-card:nth-child(2) { animation-delay: 0.08s; }
+.sacred-library-grid > .sacred-book-card:nth-child(3) { animation-delay: 0.14s; }
+.sacred-library-grid > .sacred-book-card:nth-child(4) { animation-delay: 0.20s; }
+.sacred-library-grid > .sacred-book-card:nth-child(5) { animation-delay: 0.26s; }
+.sacred-library-grid > .sacred-book-card:nth-child(6) { animation-delay: 0.32s; }
+.sacred-library-grid > .sacred-book-card:nth-child(7) { animation-delay: 0.38s; }
+.sacred-library-grid > .sacred-book-card:nth-child(8) { animation-delay: 0.44s; }
+.sacred-library-grid > .sacred-book-card:nth-child(n+9) { animation-delay: 0.5s; }
+
+/* ── Press states (tactile feedback) ── */
+.sacred-book-card:active {
+  transform: translateY(-1px) scale(0.995);
+  transition: transform 0.08s;
+}
+.sacred-book-card .btn-inline:active,
+.primary:active,
+.secondary:active,
+.ghost:active,
+.nav-toggle-btn:active {
+  transform: translateY(0) scale(0.98);
+  transition: transform 0.06s;
+}
+
+/* ── Gold shimmer sweep on cover hover ── */
+.sacred-book-cover::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: linear-gradient(
+    115deg,
+    transparent 0%,
+    transparent 40%,
+    rgba(201, 169, 97, 0.22) 50%,
+    transparent 60%,
+    transparent 100%
+  );
+  transform: translateX(-110%);
+  transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
+  z-index: 4;
+}
+.sacred-book-card:hover .sacred-book-cover::after {
+  transform: translateX(110%);
+}
+
+/* ── Button hover lift (consistent across all CTAs) ── */
+.customer-app .primary,
+.customer-app .secondary,
+.customer-app .ghost {
+  transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s, background 0.22s;
+}
+.customer-app .primary:hover:not(:disabled) {
+  transform: translateY(-1px);
+  box-shadow: 0 10px 28px -14px rgba(201, 169, 97, 0.55);
+}
+
+/* ── Focus-visible (accessibility + polish) ── */
+.customer-app button:focus-visible,
+.customer-app a:focus-visible,
+.customer-app input:focus-visible {
+  outline: 2px solid rgba(201, 169, 97, 0.6);
+  outline-offset: 2px;
+  border-radius: 6px;
+}
+
+/* ── Skeleton loaders ── */
+@keyframes bv-skeleton-shimmer {
+  0%   { background-position: -400px 0; }
+  100% { background-position: 400px 0; }
+}
+.skeleton-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
+  gap: 24px 20px;
+  padding: 8px 0 12px;
+  margin: 0 auto;
+  max-width: 1140px;
+}
+.skeleton-card {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.skeleton-card .skeleton-cover {
+  aspect-ratio: 2 / 3;
+  border-radius: 6px;
+  background: linear-gradient(
+    90deg,
+    rgba(201, 169, 97, 0.06) 0%,
+    rgba(201, 169, 97, 0.14) 50%,
+    rgba(201, 169, 97, 0.06) 100%
+  );
+  background-size: 800px 100%;
+  animation: bv-skeleton-shimmer 1.6s infinite linear;
+  border: 1px solid rgba(201, 169, 97, 0.08);
+}
+.skeleton-card .skeleton-line {
+  height: 10px;
+  border-radius: 4px;
+  background: linear-gradient(
+    90deg,
+    rgba(235, 225, 210, 0.04) 0%,
+    rgba(235, 225, 210, 0.10) 50%,
+    rgba(235, 225, 210, 0.04) 100%
+  );
+  background-size: 800px 100%;
+  animation: bv-skeleton-shimmer 1.6s infinite linear;
+}
+.skeleton-card .skeleton-line.short { width: 40%; }
+.skeleton-card .skeleton-line.medium { width: 70%; }
+
+@media (max-width: 640px) {
+  .skeleton-grid { grid-template-columns: repeat(2, 1fr); gap: 16px 12px; }
+}
+
+/* ── Respect reduced motion ── */
+@media (prefers-reduced-motion: reduce) {
+  .sacred-library-grid > .sacred-book-card,
+  .sacred-book-cover::after,
+  .skeleton-cover,
+  .skeleton-line {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+/* ═════════════════════════════════════════════════════════════════
+   POLISH BLOCK 2 — Receipt cover, empty states, detail page refinements
+   ═════════════════════════════════════════════════════════════════ */
+
+/* ── Receipt: add cover frame ── */
+.receipt-cover-frame {
+  width: 120px;
+  aspect-ratio: 4 / 5;
+  margin: 0 auto 18px;
+  border-radius: 6px;
+  overflow: hidden;
+  border: 1px solid rgba(201, 169, 97, 0.35);
+  box-shadow:
+    0 0 0 1px rgba(201, 169, 97, 0.15),
+    0 20px 40px -20px rgba(0, 0, 0, 0.9),
+    0 0 60px -15px rgba(201, 169, 97, 0.4);
+  position: relative;
+  background: #0c0907;
+}
+.receipt-cover-img {
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  object-position: bottom center;
+  display: block;
+  background: #0c0907;
+}
+@keyframes bv-receipt-glow {
+  0%, 100% { box-shadow: 0 0 0 1px rgba(201, 169, 97, 0.15), 0 20px 40px -20px rgba(0, 0, 0, 0.9), 0 0 60px -15px rgba(201, 169, 97, 0.4); }
+  50%      { box-shadow: 0 0 0 1px rgba(201, 169, 97, 0.25), 0 20px 40px -20px rgba(0, 0, 0, 0.9), 0 0 80px -12px rgba(201, 169, 97, 0.55); }
+}
+.receipt-overlay:not(.hidden) .receipt-cover-frame {
+  animation: bv-receipt-glow 3s ease-in-out infinite;
+}
+
+/* ── Empty state card (when catalog is empty) ── */
+.empty-card.stage-empty-state {
+  text-align: center;
+  padding: 56px 32px;
+  background: linear-gradient(180deg, rgba(25, 20, 19, 0.4), rgba(15, 14, 17, 0.6));
+  border: 1px dashed rgba(201, 169, 97, 0.2);
+  border-radius: 14px;
+  margin: 32px auto;
+  max-width: 520px;
+}
+.empty-card.stage-empty-state::before {
+  content: '\2756';
+  display: block;
+  font-size: 32px;
+  color: rgba(201, 169, 97, 0.5);
+  margin-bottom: 14px;
+}
+.empty-card.stage-empty-state h3 {
+  margin: 0 0 8px;
+  font-family: 'Cormorant Garamond', serif;
+  color: var(--book-ink, #ebe1d2);
+}
+.empty-card.stage-empty-state p {
+  margin: 0;
+  color: var(--book-muted, #bdafa0);
+  font-size: 13px;
+}
+
+/* ── Detail page: subtle golden aura around cover ── */
+.book-page-cover-sacred {
+  position: relative;
+}
+.book-page-cover-sacred::before {
+  content: '';
+  position: absolute;
+  inset: -12px;
+  border-radius: 10px;
+  background: radial-gradient(ellipse at center, rgba(201, 169, 97, 0.18), transparent 65%);
+  z-index: -1;
+  pointer-events: none;
+  filter: blur(8px);
+}
+
+/* ── Detail page: tighter meta row visual ── */
+.book-page-meta-sacred > div {
+  position: relative;
+  padding-left: 14px;
+}
+.book-page-meta-sacred > div::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  top: 50%;
+  transform: translateY(-50%);
+  width: 3px;
+  height: 60%;
+  background: linear-gradient(180deg, rgba(201, 169, 97, 0.8), rgba(201, 169, 97, 0.2));
