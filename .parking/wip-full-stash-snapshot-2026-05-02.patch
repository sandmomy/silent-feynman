+  .login-stage-layout { grid-template-columns: 1fr; gap: 12px; }
+  .login-benefit-card-side { display: none; } /* focus on form on mobile */
+  .catalog-hero h1 { font-size: clamp(1.6rem, 7vw, 2rem); }
+  .catalog-hero-quote { font-size: 0.88rem; }
+  .book-page-meta-sacred { grid-template-columns: 1fr; gap: 8px; }
+  .bv-onboarding-toast { font-size: 12px; padding: 12px 18px; }
+}
+
+/* ── Respect reduced motion for block 3 ── */
+@media (prefers-reduced-motion: reduce) {
+  .journey-bar-copy .eyebrow,
+  .journey-bar-copy h1,
+  .journey-bar-copy p,
+  .journey-bar-copy::after,
+  .journey-bar-track,
+  .bv-onboarding-toast {
+    animation: none !important;
+  }
+  .journey-bar-copy h1 {
+    color: var(--book-ink);
+    background: none;
+    -webkit-text-fill-color: initial;
+  }
+}
