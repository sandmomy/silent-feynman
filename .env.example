# BookVoice Reader — Environment Variables
# Copy this file to .env and fill in your values.

# Server
BOOKVOICE_HOST=0.0.0.0
BOOKVOICE_PORT=8010

# Admin access (required for auth to work)
BOOKVOICE_ADMIN_USERNAME=eugene
BOOKVOICE_ADMIN_PASSWORD=change-me-in-production

# Session
BOOKVOICE_SESSION_SECRET=generate-a-random-64-char-string
BOOKVOICE_SESSION_HOURS=24

# Self-signup (set to false to disable public registration)
BOOKVOICE_SELF_SIGNUP_ENABLED=true

# Google OAuth (optional — leave empty to hide the button)
BOOKVOICE_GOOGLE_CLIENT_ID=
BOOKVOICE_GOOGLE_CLIENT_SECRET=

# Demo readers (for client previews)
BOOKVOICE_DEMO_CUSTOMER_USERNAME=lector
BOOKVOICE_DEMO_CUSTOMER_PASSWORD=000
BOOKVOICE_DEMO_OWNED_CUSTOMER_USERNAME=lector_owned
BOOKVOICE_DEMO_OWNED_CUSTOMER_PASSWORD=000

# Voice generation (disabled by default)
OPENVOICE_WSL_ENABLED=false
